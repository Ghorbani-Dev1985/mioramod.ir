{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./src",
    "paths": {
      "@/common": ["common"],
      "@/common/*": ["common/*"],

      "@/components": ["components"],
      "@/components/*": ["components/*"],

      "@/constants": ["constants"],
      "@/constants/*": ["constants/*"],

      "@/contexts": ["contexts"],
      "@/contexts/*": ["contexts/*"],

      "@/hooks": ["hooks"],
      "@/hooks/*": ["hooks/*"],

      "@/lib": ["lib"],
      "@/lib/*": ["lib/*"],

      "@/middlewares": ["middlewares"],
      "@/middlewares/*": ["middlewares/*"],

      "@/models": ["models"],
      "@/models/*": ["models/*"],

      "@/services": ["services"],
      "@/services/*": ["services/*"],

      "@/styles": ["styles"],
      "@/styles/*": ["styles/*"],

      "@/ui": ["ui"],
      "@/ui/*": ["ui/*"]
    }

  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
